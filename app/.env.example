# Local development only. Copy this file to app/.env.local:
#   cp app/.env.example app/.env.local
#
# Both values come from `supabase status -o env` after `supabase start`:
#   VITE_SUPABASE_URL      <- API_URL
#   VITE_SUPABASE_ANON_KEY <- ANON_KEY
#
# They are for the local stack only and are safe to expose in the browser.
# Never copy the service-role key or the secret key here, and never put any
# server-only value behind a VITE_ prefix. Restart `npm run dev` after editing.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
